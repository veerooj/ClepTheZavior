<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="MainPanel" style="flex-grow: 1; flex-direction: row; background-color: rgba(213, 123, 238, 0.573);">
        
        <!-- IZQUIERDA: SKILL TREE (60%) -->
        <ui:VisualElement name="SkillTree" style="width: 60%; height: 100%; border-right-width: 2px; border-right-color: rgb(0, 0, 0); flex-direction: row; flex-wrap: wrap;">
            
            <!-- DINOS (50% x 50%) -->
            <ui:VisualElement name="Dinos" style="width: 50%; height: 50%; flex-direction: row; padding: 10px; background-color: rgb(255, 254, 198);">
                <ui:VisualElement name="DinoParty" style="flex-grow: 1; align-items: center;"/>
                <ui:VisualElement name="DinCoin" style="flex-grow: 1; align-items: center;"/>
                <ui:VisualElement name="24kDino" style="flex-grow: 1; align-items: center;"/>
            </ui:VisualElement>

            <!-- PLAYER (50% x 50%) -->
            <ui:VisualElement name="Player" style="width: 50%; height: 50%; flex-direction: row; padding: 10px; background-color: rgb(175, 255, 181);">
                <ui:VisualElement name="ZoubleJump" style="flex-grow: 1; align-items: center;"/>
                <ui:VisualElement name="ZetPack" style="flex-grow: 1; align-items: center;"/>
                <ui:VisualElement name="ClepRescue" style="flex-grow: 1; align-items: center;"/>
            </ui:VisualElement>

            <!-- GUN (50% x 50%) -->
            <ui:VisualElement name="Gun" style="width: 50%; height: 50%; flex-direction: row; padding: 10px; background-color: rgb(112, 156, 249);">
                <ui:VisualElement name="Capazity_1_4" style="flex-grow: 1; align-items: center;"/>
                <ui:VisualElement name="Capazity_5_8" style="flex-grow: 1; align-items: center;"/>
            </ui:VisualElement>

            <!-- DOME (50% x 50%) -->
            <ui:VisualElement name="Dome" style="width: 50%; height: 50%; flex-direction: row; padding: 10px; background-color: rgb(176, 176, 176);">
                <ui:VisualElement name="ZaveThem" style="flex-grow: 1; align-items: center;"/>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- DERECHA: SKILL PANEL (40%) -->
        <ui:VisualElement name="Skill" style="width: 40%; height: 100%; background-color: rgba(255, 255, 255, 0.85); flex-direction: column;">
            
            <!-- DESCRIPCIÓN (60%) -->
            <ui:VisualElement name="SkillDescription" style="height: 60%; width: 100%; padding: 15px; justify-content: space-between; border-bottom-width: 2px; border-bottom-color: rgb(0, 0, 0);">
                <ui:Label text="Dino Coins: 0" name="DinoCoins" style="font-size: 18px; -unity-font-style: bold; -unity-text-align: upper-right;"/>
                <ui:Label text="SKILL NAME" name="SkillName" style="font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
                <ui:Label text="Select a skill to see its description." name="SkillDesc" style="font-size: 16px; white-space: normal; -unity-text-align: middle-center; flex-grow: 1;"/>
                <ui:Label text="Cost: 0" name="SkillCost" style="font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
            </ui:VisualElement>

            <!-- COMPRAR (40%) -->
            <ui:VisualElement name="BuyPanel" style="height: 40%; width: 100%; padding: 15px; justify-content: center; align-items: center;">
                <ui:Button text="BUY SKILL" name="BuyButton" style="width: 70%; height: 50px; font-size: 20px; -unity-font-style: bold; margin-bottom: 10px;"/>
                <ui:Label text="Not enough coins" name="NotEnoughText" style="font-size: 14px; color: rgb(200, 30, 30); -unity-text-align: middle-center;"/>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
